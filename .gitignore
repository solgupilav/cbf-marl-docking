# Python
__pycache__/
*.pyc
*.egg-info/
.venv/

# Trained policies: keep each policy's config.pkl and checkpoints/policy.pt;
# ignore the log folder BenchMARL writes into checkpoints/<name>/ on reload.
*.pt
!checkpoints/*/checkpoints/policy.pt
checkpoints/*/*
!checkpoints/*/config.pkl
!checkpoints/*/checkpoints/

# Generated by the reproduction scripts
runs/
outputs/
logs/
figures/
results/figure_data/figdata.npz
results/figure_data/intervention_*.npz
results/probabilistic_safety/exposure*/
*.mp4
*.gif
.DS_Store

# Experiment folders BenchMARL creates in the working directory
mappo_*/
